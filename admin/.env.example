# ---- Required ----------------------------------------------------------
# Admin login. Generate the hash with:  npm run hash-password -- 'your-password'
# (in this file every $ in the hash must be written \$ — the script prints that form)
ADMIN_EMAIL=phong@sinvesta.com.au
ADMIN_PASSWORD_HASH=

# Signs session tokens. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ---- Storage -----------------------------------------------------------
# "netlify" (Netlify Blobs, default in production) or "file" (./.data, default in dev)
# CMS_STORAGE=file

# ---- Quote enquiry emails (optional but recommended) -------------------
# Without these, enquiries are still saved and listed in the dashboard,
# but no email is sent. Get a key at https://resend.com and verify your domain.
RESEND_API_KEY=
RESEND_FROM="Sinvesta Website <quotes@sinvesta.com.au>"

# Extra origins allowed to POST enquiries (comma separated). The Site URL from
# Global Settings is always allowed.
# ALLOWED_ORIGINS=https://sinvesta.com.au
